<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header bar with back and calendar buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Back button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_arrow_back"
                android:backgroundTint="@color/text_primary"
                app:cornerRadius="24dp"
                app:strokeColor="@color/ice_blue_primary"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Calendar button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalendar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_calendar"
                android:backgroundTint="@color/text_primary"
                app:cornerRadius="24dp"
                app:strokeColor="@color/ice_blue_primary"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </RelativeLayout>

        <!-- Bold heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the emoji that matches your today's mood."
            style="@style/HeaderText"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Today's date in rounded pill -->
        <TextView
            android:id="@+id/tvCurrentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17th April 2025"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/date_pill_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Emoji buttons in two rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- First row of emojis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <!-- Happy emoji -->
                <LinearLayout
                    android:id="@+id/emojiHappy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😊"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Happy"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Sad emoji -->
                <LinearLayout
                    android:id="@+id/emojiSad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😔"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sad"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Angry emoji -->
                <LinearLayout
                    android:id="@+id/emojiAngry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😡"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Angry"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Second row of emojis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Anxious emoji -->
                <LinearLayout
                    android:id="@+id/emojiAnxious"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😟"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anxious"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Neutral emoji -->
                <LinearLayout
                    android:id="@+id/emojiNeutral"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😐"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neutral"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Excited emoji -->
                <LinearLayout
                    android:id="@+id/emojiExcited"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardBackgroundColor="@color/dark_card"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/dark_card"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="😍"
                            android:textSize="48sp"
                            android:gravity="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excited"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Notes section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes (Optional)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxStrokeColor="@color/ice_blue_primary"
            app:hintTextColor="@color/ice_blue_accent"
            android:textColorHint="@color/text_secondary"
            app:boxBackgroundColor="@color/dark_card"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp">

            <EditText
                android:id="@+id/etMoodNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Want to write something about your day?"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textMultiLine"
                android:lines="3"
                android:padding="16dp"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:background="@null" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Submit button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitMood"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit Mood"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ice_blue_accent"
            app:cornerRadius="12dp"
            app:elevation="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Mood History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mood History"
                style="@style/SubHeaderText" />

            <TextView
                android:id="@+id/tvMoodCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 entries"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Non-scrolling RecyclerView - height will be calculated dynamically -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dark_background"
            android:padding="4dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>